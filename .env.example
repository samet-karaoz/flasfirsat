# API Anahtarlarınız
# Google AI Studio (Ücretsiz): https://aistudio.google.com/
GEMINI_API_KEY=

# Pexels (Ücretsiz): https://www.pexels.com/api/
PEXELS_API_KEY=

# Telegram Bildirimleri & Kanal Yayını:
# 1. Telegram'da @BotFather ile bot açın, verdiği TOKEN:
TELEGRAM_BOT_TOKEN=
# 2. Telegram'da @userinfobot ile kendi şahsi Chat ID numaranız:
TELEGRAM_CHAT_ID=
# 3. Yayın yapılacak Telegram Kanal kullanıcı adı veya ID (örn: @flasfirsat):
TELEGRAM_CHANNEL_ID=@flasfirsat

# Gelir Ortaklığı (Affiliate) Kodları:
AMAZON_AFFILIATE_TAG=flasfirsat04-21
TRENDYOL_AFFILIATE_TAG=
HEPSIBURADA_AFFILIATE_TAG=
